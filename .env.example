# Copy to .env.local and fill in.

# Postgres connection string.
# The docker-compose service in this repo is reachable at:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kleanchile"

# Public origin. Required in production: canonical tags, og:image, og:url and
# every URL in the sitemap are built from it. Left unset, they all point at
# localhost and link previews break.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Set to 1 to log every SQL statement Drizzle emits. Off by default: one page
# render fires several queries and the output buries real stack traces.
# DRIZZLE_LOG=1
