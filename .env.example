# Copy to .env.local and fill in.

# Postgres connection string.
# The docker-compose service in this repo is reachable at:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kleanchile"

# Public origin. Required in production: canonical tags, og:image, og:url and
# every URL in the sitemap are built from it. Left unset, they all point at
# localhost and link previews break.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Almacenamiento de imágenes (Cloudflare R2) ───────────────────────────────
#
# Las cinco o ninguna. Sin ellas las subidas van a public/uploads/, que sirve
# en desarrollo y en un VPS con volumen, pero NO en un host serverless: el disco
# es efímero y la foto desaparece en el siguiente despliegue.
#
# Con ellas, el navegador sube directo al bucket y el servidor genera el
# escalón AVIF/WebP. Ver docs/DEPLOY.md.
#
# NEXT_PUBLIC_CDN_URL es de dónde se SIRVEN las imágenes, no dónde vive el sitio.
# Con dominio propio en el bucket es "https://cdn.kleanchile.cl"; sin él sirve la
# URL de desarrollo que da Cloudflare (R2 → bucket → Settings → Public
# Development URL), del estilo "https://pub-<hash>.r2.dev".
#
# Ojo al cambiarla después: la URL completa queda escrita en cada
# `products.image_url`, así que las fotos subidas con la anterior siguen
# apuntando ahí. Poner el dominio definitivo antes de cargar el catálogo ahorra
# un UPDATE sobre la tabla.
#
# R2_ACCOUNT_ID="..."
# R2_ACCESS_KEY_ID="..."
# R2_SECRET_ACCESS_KEY="..."
# R2_BUCKET="kleanchile"
# NEXT_PUBLIC_CDN_URL="https://pub-....r2.dev"

# ── Vista previa privada ─────────────────────────────────────────────────────
#
# Con PREVIEW_PASSWORD puesta, todo el sitio pide usuario y contraseña por
# autenticación básica: sirve para que el cliente revise antes del lanzamiento
# sin que el público ni Google vean nada. Bórrala y vuelve a desplegar para
# abrirlo. Sin ella, `middleware.js` no hace nada.
#
# PREVIEW_USER="kleanchile"    # opcional; este es el valor por defecto
# PREVIEW_PASSWORD="..."

# Set to 1 to log every SQL statement Drizzle emits. Off by default: one page
# render fires several queries and the output buries real stack traces.
# DRIZZLE_LOG=1
