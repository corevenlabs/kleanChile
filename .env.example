# Copy to .env.local and fill in.

# Postgres connection string.
# The docker-compose service in this repo is reachable at:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kleanchile"

# Public origin. Required in production: canonical tags, og:image, og:url and
# every URL in the sitemap are built from it. Left unset, they all point at
# localhost and link previews break.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Almacenamiento de imágenes (Cloudflare R2) ───────────────────────────────
#
# Las cinco o ninguna. Sin ellas las subidas van a public/uploads/, que sirve
# en desarrollo y en un VPS con volumen, pero NO en un host serverless: el disco
# es efímero y la foto desaparece en el siguiente despliegue.
#
# Con ellas, el navegador sube directo al bucket y el servidor genera el
# escalón AVIF/WebP. Ver docs/DEPLOY.md.
#
# R2_ACCOUNT_ID="..."
# R2_ACCESS_KEY_ID="..."
# R2_SECRET_ACCESS_KEY="..."
# R2_BUCKET="kleanchile"
# NEXT_PUBLIC_CDN_URL="https://cdn.kleanchile.cl"

# Set to 1 to log every SQL statement Drizzle emits. Off by default: one page
# render fires several queries and the output buries real stack traces.
# DRIZZLE_LOG=1
